# URL de l'application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase / Auth Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ADMIN_EMAILS=admin@nvd.sn

# Firebase Keys (optionnel si Firebase Auth / Firestore est active)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id

# Cloudflare R2 (Object Storage S3-Compatible)
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=nvd-storage
NEXT_PUBLIC_CLOUDFLARE_R2_PUBLIC_URL=https://pub-your-bucket-id.r2.dev

# Coordonnees NVD Senegal
NEXT_PUBLIC_PRIMARY_PHONE=778609143
NEXT_PUBLIC_SECONDARY_PHONE=788605633
NEXT_PUBLIC_WHATSAPP_NUMBER=778609143

# Cloudinary pour le CMS admin (optionnel si le CMS media n'est pas utilise)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
